+/*---------------------------------------------------------*\
+| Color-only re-sends to a running animated effect restart  |
+| its phase on the wire (no phase parameter or in-place     |
+| color update exists on 0x8070/0x8071). They are always    |
+| deferred to the effect's next phase boundary, computed    |
+| from the last send time and period, so the restart lands  |
+| where the animation already is; the latest color wins at  |
+| the boundary. Effects faster than the minimum period      |
+| skip the dance: their restart is imperceptible.           |
+\*---------------------------------------------------------*/
+static const uint64_t HIDPP20_PHASE_WINDOW_MS     = 100;
+static const uint16_t HIDPP20_PHASE_MIN_PERIOD_MS = 400;
+
+/*---------------------------------------------------------*\
+| Frame-delay effects (Ripple) restart visibly on every     |
+| re-send, so their color is locked at apply time and       |
+| never follows the draw buffer; recoloring takes an        |
+| explicit mode, param, or swatch change.                   |
+\*---------------------------------------------------------*/
+static bool EffectColorLockedWhileRunning(int mode_value)
+{
+    return (mode_value == 0x000B || mode_value == 0x0017);
+}
+
+/*---------------------------------------------------------*\
+| Effects that render an RGB parameter. Others get color 0  |
+| in the zone state so color paints never dirty them.       |
+\*---------------------------------------------------------*/
+/*---------------------------------------------------------*\
+| Long timed loops group by family, so zones with the same  |
+| underlying loop and period share a starting point even    |
+| across effect ids: the self-cycle Visualizer runs the     |
+| same color loop as Spectrum Cycle with audio modulation   |
+| on top, and the saturation variants are the same loops    |
+| as their base effects. Ripple and Decomposition/          |
+| Signature use their timer as a frame delay, not a loop,   |
+| and never group. Returns -1 for non-looping effects; the  |
+| Visualizer loops only in self-cycle mode (color 0).       |
+\*---------------------------------------------------------*/
+static int EffectLoopFamily(const HIDPP20ZoneState& s)
+{
+    switch(s.mode_value)
+    {
+        case 0x0003:    // Spectrum Cycle
+        case 0x0015:    // Cycle (saturation variant)
+            return 0x0003;
+        case 0x0007:    // Audio Visualizer (modulated color loop)
+            return (s.color == 0) ? 0x0003 : -1;
+        case 0x0004:    // Color Wave
+        case 0x0016:    // Wave (saturation variant)
+            return 0x0004;
+        case 0x000A:    // Breathing
+            return 0x000A;
+        default:
+            return -1;
+    }
+}
+
+static bool EffectUsesColor(int mode_value)
+{
+    switch(mode_value)
+    {
+        case HIDPP20_MODE_VALUE_DIRECT:
+        case HIDPP20_MODE_VALUE_DARK_VISUALIZER:
+        case 0x0001:    // Static
+        case 0x0007:    // Audio Visualizer
+        case 0x000A:    // Breathing
+        case 0x000B:    // Ripple
+        case 0x0017:    // Ripple (saturation variant)
+            return true;
+        default:
+            return false;
+    }
+}
+
+/*---------------------------------------------------------*\
+| Dark Visualizer: a pseudo-mode offered alongside the      |
+| stock Audio Visualizer (0x0007). It audio-pulses the      |
+| zone's literal color, but a black zone renders black      |
+| instead of the firmware self-cycle: painted zones emit    |
+| 0x0007, black zones emit Static black.                    |
+\*---------------------------------------------------------*/
+static mode MakeDarkVisualizerMode(bool per_led_colors)
+{
+    mode out;
+
+    out.name       = "Dark Visualizer";
+    out.value      = HIDPP20_MODE_VALUE_DARK_VISUALIZER;
+    out.speed_min  = HIDPP20_SPEED_SLIDER_MIN;
+    out.speed_max  = HIDPP20_SPEED_SLIDER_MAX;
+    out.speed      = 80;
+
+    if(per_led_colors)
+    {
+        out.flags      = MODE_FLAG_HAS_PER_LED_COLOR
+                       | MODE_FLAG_HAS_SPEED;
+        out.color_mode = MODE_COLORS_PER_LED;
+    }
+    else
+    {
+        out.flags      = MODE_FLAG_HAS_MODE_SPECIFIC_COLOR
+                       | MODE_FLAG_HAS_SPEED;
+        out.colors_min = 1;
+        out.colors_max = 1;
+        out.color_mode = MODE_COLORS_MODE_SPECIFIC;
+        out.colors.resize(1);
+    }
+
+    return out;
+}
+
+/*---------------------------------------------------------*\
+| Wire-relevant equality: what the device would actually    |
+| render, and so the only reason to re-send.                |
+\*---------------------------------------------------------*/
+static bool SameWireState(const HIDPP20ZoneState& a, const HIDPP20ZoneState& b)
+{
+    return a.mode_value == b.mode_value
+        && a.color      == b.color
+        && a.speed      == b.speed
+        && a.brightness == b.brightness
+        && a.direction  == b.direction;
+}
