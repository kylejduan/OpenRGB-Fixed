+static bool ClusterHasEffect(const HIDPP20ZoneCluster& cluster, uint16_t effect_id)
+{
+    for(size_t i = 0; i < cluster.effects.size(); i++)
+    {
+        if(cluster.effects[i].effect_id == effect_id)
